# Add as Environment variables in Portainer Stack (or load this file after editing).
# GitHub repository: https://github.com/khaisilk1910/troflow
TROFLOW_IMAGE=ghcr.io/khaisilk1910/troflow:latest
# Default allows access only from reverse proxy on the same Docker host.
TROFLOW_BIND_IP=0.0.0.0
PORT=8088
# Use COOKIE_SECURE=1 only when the browser uses HTTPS.
COOKIE_SECURE=0
TROFLOW_TZ=Asia/Ho_Chi_Minh
